@inject RestaurantManagement.Services.PermissionService Perm
@{
    var ctl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var act = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var isAdmin = User.IsInRole("Admin");
    var perms = await Perm.AllAsync();
    bool V(string key) => isAdmin || (perms.TryGetValue(key, out var p) && p.CanView);
    string Active(string c) => string.Equals(ctl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var groups = RestaurantManagement.Services.ModuleCatalog.All;
    bool Any(params string[] keys) => keys.Any(V);
}
<nav class="side-nav">
    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

    @if (Any("Pos", "Kitchen", "Waiter", "Billing"))
    {
        <div class="nav-heading">Operations</div>
        @if (V("Pos"))
        {
            <a class="nav-link @(ctl == "Pos" && act == "Index" ? "active" : "")" asp-controller="Pos" asp-action="Index"><i class="bi bi-grid-3x3-gap-fill"></i> Tables &amp; Orders</a>
            <a class="nav-link" asp-controller="Pos" asp-action="Order" asp-route-type="Parcel"><i class="bi bi-bag"></i> New Parcel Order</a>
            <a class="nav-link @(ctl == "Pos" && act == "Orders" ? "active" : "")" asp-controller="Pos" asp-action="Orders"><i class="bi bi-list-ol"></i> Order Queue</a>
        }
        @if (V("Kitchen")) { <a class="nav-link @Active("Kitchen")" asp-controller="Kitchen" asp-action="Index"><i class="bi bi-fire"></i> Kitchen Display</a> }
        @if (V("Waiter")) { <a class="nav-link @Active("Waiter")" asp-controller="Waiter" asp-action="Index"><i class="bi bi-bell"></i> Waiter / Bearer</a> }
        @if (V("Billing")) { <a class="nav-link @Active("Billing")" asp-controller="Billing" asp-action="Index"><i class="bi bi-receipt"></i> Billing &amp; Payments</a> }
    }

    @if (Any("Expenses", "Reports", "ExpenseCategories"))
    {
        <div class="nav-heading">Finance</div>
        @if (V("Reports")) { <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="ProfitLoss"><i class="bi bi-graph-up-arrow"></i> Profit &amp; Loss</a> }
        @if (V("Expenses")) { <a class="nav-link @Active("Expenses")" asp-controller="Expenses" asp-action="Index"><i class="bi bi-journal-minus"></i> Restaurant Expenses</a> }
        @if (V("ExpenseCategories")) { <a class="nav-link @Active("ExpenseCategories")" asp-controller="ExpenseCategories" asp-action="Index"><i class="bi bi-wallet2"></i> Expense Categories</a> }
    }

    @foreach (var g in new[] { "Menu", "Dining", "Staff", "Customers", "Stock & Purchase", "Billing" })
    {
        var mods = groups.Where(m => m.Group == g && V(m.Key)).ToList();
        if (mods.Count == 0) { continue; }
        <div class="nav-heading">@g</div>
        @foreach (var m in mods)
        {
            <a class="nav-link @Active(m.Key)" asp-controller="@m.Key" asp-action="Index"><i class="bi @m.Icon"></i> @m.Title</a>
        }
    }

    @if (isAdmin)
    {
        <div class="nav-heading">Administration</div>
        <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i> Users &amp; Login</a>
        <a class="nav-link @Active("Permissions")" asp-controller="Permissions" asp-action="Index"><i class="bi bi-shield-lock"></i> User Permissions</a>
        <a class="nav-link @Active("Branches")" asp-controller="Branches" asp-action="Index"><i class="bi bi-shop"></i> Branches</a>
    }
    else if (V("Branches"))
    {
        <div class="nav-heading">Administration</div>
        <a class="nav-link @Active("Branches")" asp-controller="Branches" asp-action="Index"><i class="bi bi-shop"></i> Branches</a>
    }
</nav>
