@model BillViewModel
@{
    Layout = null;
    var o = Model.Order; var s = Model.Setting;
    var live = o.Items.Where(i => i.Status != "Cancelled").ToList();
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><title>Receipt @o.OrderNo</title>
<style>
 body{font-family:"Segoe UI",Arial,sans-serif;font-size:13px;width:300px;margin:12px auto;color:#000}
 h2,h4,p{margin:2px 0;text-align:center} table{width:100%;border-collapse:collapse;margin-top:8px}
 td,th{padding:2px 0;font-size:12.5px} .r{text-align:right} hr{border:0;border-top:1px dashed #000;margin:6px 0}
</style></head>
<body onload="window.print()">
 <h2>@s.RestaurantName</h2>
 @if (!string.IsNullOrWhiteSpace(s.OwnerMobile)) { <p>Ph: @s.OwnerMobile</p> }
 <hr />
 <p style="text-align:left">Bill: <b>@o.OrderNo</b> &nbsp; @(o.OrderType == "Parcel" ? "Parcel" : "Table " + o.DiningTable?.TableNumber)</p>
 <p style="text-align:left">@RestaurantManagement.Services.OrderLogic.ToIst(o.CreatedOn).ToString("dd/MM/yyyy hh:mm tt")</p>
 @if (!string.IsNullOrEmpty(o.CustomerName)) { <p style="text-align:left">Customer: @o.CustomerName @o.CustomerMobile</p> }
 <table>
  <tr><th style="text-align:left">Item</th><th class="r">Qty</th><th class="r">Amt</th></tr>
  @foreach (var i in live) { <tr><td>@i.ItemName @if (!string.IsNullOrEmpty(i.AddonNames)) { <br /><small>+ @i.AddonNames</small> }</td><td class="r">@i.Quantity</td><td class="r">@i.LineTotal.ToString("N2")</td></tr> }
 </table>
 <hr />
 <table>
  <tr><td>Sub-total</td><td class="r">@o.SubTotal.ToString("N2")</td></tr>
  <tr><td>GST (@o.TaxPercentEffective.ToString("0.##")%)</td><td class="r">@o.TaxAmount.ToString("N2")</td></tr>
  @if (o.DiscountAmount > 0) { <tr><td>Discount @o.DiscountCode (@o.DiscountPercentEffective.ToString("0.##")%)</td><td class="r">-@o.DiscountAmount.ToString("N2")</td></tr> }
  <tr><td>Round off</td><td class="r">@o.RoundOff.ToString("N2")</td></tr>
  <tr><td><b>TOTAL</b></td><td class="r"><b>&#8377;@o.GrandTotal.ToString("N2")</b></td></tr>
  <tr><td>Paid @(o.Payments.Any() ? "(" + o.PaymentModeText + ")" : "")</td><td class="r">@o.PaidAmount.ToString("N2")</td></tr>
  @if (o.TipAmount > 0) { <tr><td>Tip (thank you!)</td><td class="r">@o.TipAmount.ToString("N2")</td></tr> }
 </table>
 <hr />
 <p>@s.BillFooter</p>
</body></html>
