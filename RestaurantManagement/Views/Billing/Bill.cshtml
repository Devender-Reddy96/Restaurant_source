@model BillViewModel
@{
    var o = Model.Order;
    var s = Model.Setting;
    var open = o.Status == "Open";
    ViewData["Title"] = "Bill " + o.OrderNo;
    var live = o.Items.Where(i => i.Status != "Cancelled").ToList();
    var hasUpi = !string.IsNullOrWhiteSpace(s.UpiId);
}
<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-receipt"></i> Bill @o.OrderNo <span class="badge b-@o.Status.ToLowerInvariant()">@o.Status</span></h1>
        <p class="page-sub">@(o.OrderType == "Parcel" ? "Parcel order" : "Table " + o.DiningTable?.TableNumber) &middot; @RestaurantManagement.Services.OrderLogic.ToIst(o.CreatedOn).ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (open) { <a asp-controller="Pos" asp-action="Order" asp-route-orderId="@o.OrderId" class="btn btn-outline-primary"><i class="bi bi-plus-lg"></i> Add items</a> }
        <a asp-action="Receipt" asp-route-id="@o.OrderId" target="_blank" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> Print</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="bill-hero">
            <div><small>@(open ? "Amount due" : "Total")</small><div class="v">&#8377;@((open ? o.DueAmount : o.GrandTotal).ToString("N2"))</div></div>
            <div class="text-end"><small>@(o.OrderType == "Parcel" ? "Parcel" : "Table " + o.DiningTable?.TableNumber)</small><div class="fw-semibold">@o.OrderNo</div></div>
        </div>
        <div class="card data-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Tax %</th><th class="text-end">Tax</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var i in live)
                    {
                        <tr><td>@i.ItemName <span class="badge b-@i.Status.ToLowerInvariant()">@i.Status</span>
                                @if (!string.IsNullOrEmpty(i.AddonNames)) { <br /><small class="text-primary">+ @i.AddonNames (&#8377;@i.AddonUnitPrice.ToString("N2") each)</small> }</td>
                            <td class="text-end">@i.Quantity</td>
                            <td class="text-end">@((i.UnitPrice + i.AddonUnitPrice).ToString("N2"))</td><td class="text-end">@i.TaxPercent.ToString("0.##")%</td><td class="text-end">@i.TaxAmount.ToString("N2")</td><td class="text-end">@i.LineTotal.ToString("N2")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="p-3">
                <div class="d-flex justify-content-between"><span>Sub-total</span><span>&#8377;@o.SubTotal.ToString("N2")</span></div>
                <div class="d-flex justify-content-between"><span>Tax (GST @o.TaxPercentEffective.ToString("0.##")%)</span><span>&#8377;@o.TaxAmount.ToString("N2")</span></div>
                <div class="d-flex justify-content-between"><span>Discount @(o.DiscountAmount > 0 ? "(" + o.DiscountPercentEffective.ToString("0.##") + "%)" : "")
                    @if (!string.IsNullOrEmpty(o.DiscountCode)) { <span class="badge b-flat">@o.DiscountCode</span> }</span><span>- &#8377;@o.DiscountAmount.ToString("N2")</span></div>
                <div class="d-flex justify-content-between"><span>Round off</span><span>@o.RoundOff.ToString("N2")</span></div>
                <div class="d-flex justify-content-between fw-bold fs-4 border-top pt-2 mt-2"><span>Grand total</span><span>&#8377;@o.GrandTotal.ToString("N2")</span></div>
                <div class="d-flex justify-content-between text-success"><span>Paid</span><span>&#8377;@o.PaidAmount.ToString("N2")</span></div>
                <div class="d-flex justify-content-between fw-bold text-danger"><span>Due</span><span>&#8377;@o.DueAmount.ToString("N2")</span></div>
                @if (o.TipAmount > 0)
                {
                    <div class="d-flex justify-content-between text-primary"><span>Tip to @(o.WaiterEmployee?.FullName ?? "table bearer") <small>(restaurant expense)</small></span><span>&#8377;@o.TipAmount.ToString("N2")</span></div>
                }
                @if (open)
                {
                    <div class="row g-2 mt-3">
                        <div class="col-md-6">
                            <form asp-action="ApplyCoupon" asp-route-id="@o.OrderId" method="post">
                                <label class="form-label">Coupon code</label>
                                <div class="input-group">
                                    <input name="code" list="couponList" class="form-control text-uppercase" placeholder="e.g. WELCOME10" value="@o.DiscountCode" />
                                    <button class="btn btn-outline-primary">Apply</button>
                                </div>
                                <datalist id="couponList">
                                    @foreach (var c in Model.Coupons) { <option value="@c.DiscountCode">@c.DiscountName (@(c.DiscountType.StartsWith("Percent") ? c.DiscountValue.ToString("0.##") + "%" : "Rs " + c.DiscountValue.ToString("N0")), min Rs @c.MinOrderAmount.ToString("N0"))</option> }
                                </datalist>
                                <small class="text-muted">Only coupons valid today are accepted.</small>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <form asp-action="SetDiscount" asp-route-id="@o.OrderId" method="post">
                                <label class="form-label">Manual discount</label>
                                <div class="input-group">
                                    <select name="discountType" class="form-select" style="max-width:90px">
                                        <option value="Percent" selected="@(o.DiscountPercent > 0)">%</option>
                                        <option value="Amount" selected="@(o.DiscountPercent == 0)">&#8377;</option>
                                    </select>
                                    <input name="value" type="number" step="0.01" min="0" class="form-control" value="@(o.DiscountPercent > 0 ? o.DiscountPercent : o.DiscountAmount)" />
                                    <button class="btn btn-outline-primary">Set</button>
                                </div>
                                <small class="text-muted">Enter 0 to remove the discount.</small>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (o.Payments.Any())
        {
            <div class="card data-card mt-3">
                <div class="panel-title">Payments received</div>
                <table class="table mb-0">
                    @foreach (var p in o.Payments)
                    {
                        <tr><td>@p.ModeName</td><td>&#8377;@p.Amount.ToString("N2")</td><td>@p.ReferenceNo</td>
                            <td class="text-muted small">@RestaurantManagement.Services.OrderLogic.ToIst(p.CreatedOn).ToString("hh:mm tt") @p.ReceivedBy</td></tr>
                    }
                </table>
            </div>
        }
    </div>

    <div class="col-lg-5">
      <div class="bill-side">
        @if (open)
        {
            <div class="card panel mb-3 scroll-target" id="upiSection">
                <div class="panel-title"><i class="bi bi-qr-code"></i> Pay by UPI / QR</div>
                <div class="card-body upi-box">
                    @if (!hasUpi)
                    {
                        <div class="alert alert-warning">Owner UPI ID is not set yet. <a asp-controller="RestaurantSettings" asp-action="Index">Add it in Restaurant &amp; UPI Settings</a>.</div>
                    }
                    else
                    {
                        <div id="qr"></div>
                        <div class="mt-2"><b>&#8377;@o.DueAmount.ToString("N2")</b> to <b>@(string.IsNullOrWhiteSpace(s.UpiPayeeName) ? s.RestaurantName : s.UpiPayeeName)</b></div>
                        <div class="text-muted">UPI ID: <b>@s.UpiId</b></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.OwnerMobile))
                    {
                        <div class="text-muted">Or pay to mobile number: <b>@s.OwnerMobile</b> (PhonePe / GPay / Paytm)</div>
                    }
                    @if (!string.IsNullOrEmpty(o.CustomerUtr))
                    {
                        <div class="alert alert-info mt-3 mb-0 py-2">Customer says UPI ref: <b>@o.CustomerUtr</b><br /><small>Check it in your UPI app before confirming.</small></div>
                    }
                </div>
            </div>

            <div class="card panel mb-3">
                <div class="panel-title"><i class="bi bi-send"></i> Send pay link to customer</div>
                <div class="card-body">
                    @if (string.IsNullOrEmpty(o.CustomerMobile))
                    {
                        <p class="text-muted small mb-0">No customer mobile on this order. Add one while taking the order (Add items &rarr; Customer mobile).</p>
                    }
                    else
                    {
                        <p class="mb-2">Customer mobile: <b>@o.CustomerMobile</b></p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-success" target="_blank" href="@Model.WhatsAppUrl"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                            <a class="btn btn-outline-primary" href="@Model.SmsUrl"><i class="bi bi-chat-dots"></i> SMS</a>
                            <button type="button" class="btn btn-outline-secondary" id="copyLink"><i class="bi bi-clipboard"></i> Copy link</button>
                        </div>
                    }
                    <input type="text" readonly class="form-control form-control-sm mt-2" id="payLink" value="@Model.PayPageUrl" />
                    <small class="text-muted">The customer opens this page on their phone and taps their UPI app (GPay, PhonePe, Paytm, any UPI).</small>
                </div>
            </div>

            <div class="card panel scroll-target" id="paySection">
                <div class="panel-title"><i class="bi bi-cash-coin"></i> Record payment</div>
                <div class="card-body">
                    <form asp-action="RecordPayment" asp-route-id="@o.OrderId" method="post" class="vstack gap-2">
                        <select name="mode" class="form-select">
                            @foreach (var m in Model.PaymentModes) { <option selected="@(m.Equals("UPI", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(o.CustomerUtr))">@m</option> }
                        </select>
                        <div class="input-group"><span class="input-group-text">&#8377;</span><input name="amount" id="payAmount" type="number" step="0.01" min="0.01" class="form-control" value="@o.DueAmount.ToString("0.00")" /></div>
                        <div id="tipBox" class="alert alert-info py-2 mb-0 d-none">Extra <b id="tipAmt"></b> will be saved as a <b>tip</b> for the table bearer (restaurant expense).</div>
                        <select name="waiterEmployeeId" class="form-select">
                            <option value="">Table bearer: @(o.WaiterEmployee?.FullName ?? "-- select --")</option>
                            @foreach (var w in Model.Waiters) { <option value="@w.Id" selected="@(w.Id == o.WaiterEmployeeId)">@w.Name</option> }
                        </select>
                        <input name="reference" class="form-control" placeholder="UPI / card reference (optional)" value="@o.CustomerUtr" />
                        <button class="btn btn-primary big-btn"><i class="bi bi-check-circle"></i> Confirm payment received</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> This bill is @o.Status.ToLowerInvariant().</div>
        }
      </div>
    </div>
</div>

@if (open)
{
    <div class="pay-bar">
        <div><small class="d-block opacity-75">Amount due</small><b>&#8377;@o.DueAmount.ToString("N2")</b></div>
        <div class="d-flex gap-2">
            @if (hasUpi) { <a href="#upiSection" class="btn btn-sm btn-outline-light"><i class="bi bi-qr-code"></i> QR</a> }
            <a href="#paySection" class="btn btn-light fw-semibold"><i class="bi bi-cash-coin"></i> Pay now</a>
        </div>
    </div>
}

@section Scripts {
@if (open && hasUpi)
{
    <script src="~/js/qrcode.min.js" asp-append-version="true"></script>
    <script>
        new QRCode(document.getElementById('qr'), { text: @Json.Serialize(Model.UpiLink), width: 210, height: 210 });
    </script>
}
<script>
    var pa = document.getElementById('payAmount'), due = @Json.Serialize(o.DueAmount);
    if (pa) pa.addEventListener('input', function () {
        var extra = (Number(pa.value) || 0) - due;
        document.getElementById('tipBox').classList.toggle('d-none', extra <= 0.009);
        document.getElementById('tipAmt').textContent = Pos.money(extra);
    });
    var cl = document.getElementById('copyLink');
    if (cl) cl.addEventListener('click', function () {
        var i = document.getElementById('payLink'); i.select();
        (navigator.clipboard ? navigator.clipboard.writeText(i.value) : Promise.resolve(document.execCommand('copy')))
            .then(function () { cl.innerHTML = '<i class="bi bi-check2"></i> Copied'; });
    });
</script>
}
