@model IEnumerable<Tax>
@{
    ViewData["Title"] = "Taxes";
    var i = 0;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-percent"></i> Taxes</h1>
        <p class="page-sub">GST / tax slabs applied to food items. Confirm rates with your accountant.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Tax</a>
</div>

<div class="card data-card">
    <div class="card-toolbar">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control search-box" data-table="#dataTable" placeholder="Search..." />
        </div>
        <span class="record-count">@(Model.Count()) record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="dataTable">
            <thead>
                <tr><th style="width:50px">#</th><th>Tax Name</th><th>Tax %</th><th>Price Inclusive of Tax</th><th>Status</th><th class="text-end" style="width:120px">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                    <td class="text-muted">@(++i)</td>
                    <td class="fw-semibold">@(x.TaxName)</td>
                    <td>@(x.TaxPercentage.ToString("N2"))</td>
                    <td><span class="badge @(x.IsInclusive ? "b-yes" : "b-no")">@(x.IsInclusive ? "Yes" : "No")</span></td>
                    <td><span class="badge @(x.IsActive ? "b-yes" : "b-no")">@(x.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@x.TaxId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@x.TaxId" method="post" class="d-inline" data-confirm="Delete this tax?">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty-state"><i class="bi bi-inbox"></i><br />No taxes added yet. Click <strong>Add Tax</strong> to create the first one.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
