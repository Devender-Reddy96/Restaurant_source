@model IEnumerable<AppUser>
@{
    ViewData["Title"] = "Users & Login";
    var i = 0;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-person-badge"></i> Users &amp; Login</h1>
        <p class="page-sub">People who can sign in to this application, and what they can access.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add User</a>
</div>

<div class="card data-card">
    <div class="card-toolbar">
        <div class="search-wrap"><i class="bi bi-search"></i>
            <input type="text" class="form-control search-box" data-table="#dataTable" placeholder="Search..." /></div>
        <span class="record-count">@(Model.Count()) record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="dataTable">
            <thead><tr><th style="width:50px">#</th><th>User Name</th><th>Full Name</th><th>Role</th><th>Branch</th><th>Last Login</th><th>Status</th><th class="text-end" style="width:120px">Actions</th></tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td class="text-muted">@(++i)</td>
                    <td class="fw-semibold">@x.UserName</td>
                    <td>@x.FullName</td>
                    <td><span class="badge badge-soft">@(x.Role?.RoleName)</span></td>
                    <td>@(x.Branch?.BranchName)</td>
                    <td>@(x.LastLoginOn?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</td>
                    <td><span class="badge @(x.IsActive ? "b-yes" : "b-no")">@(x.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@x.UserId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-controller="Permissions" asp-action="Edit" asp-route-id="@x.UserId" class="btn btn-sm btn-outline-secondary" title="Permissions"><i class="bi bi-shield-lock"></i></a>
                        <form asp-action="Delete" asp-route-id="@x.UserId" method="post" class="d-inline" data-confirm="Delete this user?">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
