@{ ViewData["Title"] = "Waiter / Bearer"; }
@Html.AntiForgeryToken()
<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-bell"></i> Waiter / Bearer Alerts</h1>
        <p class="page-sub">Food the kitchen has marked ready. Pick it up, serve it, then tap <b>Served</b>.</p>
    </div>
    <button type="button" id="alertBtn" class="btn btn-outline-warning"><i class="bi bi-bell"></i> Enable sound alerts</button>
</div>
<div id="ready"></div>

@section Scripts {
<script>
    document.getElementById('alertBtn').addEventListener('click', function () { Pos.enableAlerts(this); });
    var refresh = Pos.poll({
        url: function () { return '/Waiter/Ready'; },
        container: '#ready', interval: 4000, alertTitle: 'Food ready', alertText: 'dish(es) ready to serve'
    });
    Pos.wirePostButtons(refresh);
</script>
}
