@model Discount
@{
    var isNew = Model.DiscountId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "Discount";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-ticket-perforated"></i> @(isNew ? "Add" : "Edit") Discount</h1>
        <p class="page-sub">Offers and coupon codes that cashiers can apply on bills.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.DiscountId.ToString())" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="DiscountId" />
            <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="DiscountName" class="form-label req"></label>
            <input asp-for="DiscountName" type="text" class="form-control" maxlength="100" />
            <span asp-validation-for="DiscountName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DiscountCode" class="form-label"></label>
            <input asp-for="DiscountCode" type="text" class="form-control" maxlength="30" />
            <span asp-validation-for="DiscountCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DiscountType" class="form-label req"></label>
            <select asp-for="DiscountType" class="form-select"><option>Percentage</option><option>Flat</option></select>
            <span asp-validation-for="DiscountType" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DiscountValue" class="form-label req"></label>
            <input asp-for="DiscountValue" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="MinOrderAmount" class="form-label req"></label>
            <input asp-for="MinOrderAmount" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ValidFrom" class="form-label"></label>
            <input type="date" id="ValidFrom" name="ValidFrom" class="form-control" value="@(Model.ValidFrom?.ToString("yyyy-MM-dd"))" />
            <span asp-validation-for="ValidFrom" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ValidTo" class="form-label"></label>
            <input type="date" id="ValidTo" name="ValidTo" class="form-control" value="@(Model.ValidTo?.ToString("yyyy-MM-dd"))" />
            <span asp-validation-for="ValidTo" class="text-danger small"></span>
        </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-md-4 pt-md-2">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> @(isNew ? "Save" : "Update")</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
