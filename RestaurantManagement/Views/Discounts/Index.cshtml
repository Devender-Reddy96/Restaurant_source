@model IEnumerable<Discount>
@{
    ViewData["Title"] = "Discounts & Coupons";
    var i = 0;
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-ticket-perforated"></i> Discounts & Coupons</h1>
        <p class="page-sub">Offers and coupon codes that cashiers can apply on bills.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Discount</a>
</div>

<div class="card data-card">
    <div class="card-toolbar">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control search-box" data-table="#dataTable" placeholder="Search..." />
        </div>
        <span class="record-count">@(Model.Count()) record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="dataTable">
            <thead>
                <tr><th style="width:50px">#</th><th>Discount Name</th><th>Discount Code</th><th>Discount Type</th><th>Discount Value</th><th>Valid To</th><th>Status</th><th class="text-end" style="width:120px">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                    <td class="text-muted">@(++i)</td>
                    <td class="fw-semibold">@(x.DiscountName)</td>
                    <td>@(x.DiscountCode)</td>
                    <td><span class="badge badge-soft b-@(x.DiscountType.ToLowerInvariant().Replace(' ', '-'))">@(x.DiscountType)</span></td>
                    <td>@(x.DiscountValue.ToString("N2"))</td>
                    <td>@(x.ValidTo?.ToString("dd MMM yyyy"))</td>
                    <td><span class="badge @(x.IsActive ? "b-yes" : "b-no")">@(x.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@x.DiscountId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@x.DiscountId" method="post" class="d-inline" data-confirm="Delete this discount?">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="empty-state"><i class="bi bi-inbox"></i><br />No discounts & coupons added yet. Click <strong>Add Discount</strong> to create the first one.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
