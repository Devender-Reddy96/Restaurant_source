@model Customer
@{
    var isNew = Model.CustomerId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "Customer";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-person-heart"></i> @(isNew ? "Add" : "Edit") Customer</h1>
        <p class="page-sub">Customer profiles and loyalty points.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.CustomerId.ToString())" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="CustomerId" />
            <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CustomerName" class="form-label req"></label>
            <input asp-for="CustomerName" type="text" class="form-control" maxlength="100" />
            <span asp-validation-for="CustomerName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label req"></label>
            <input asp-for="Phone" type="text" class="form-control" maxlength="20" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" maxlength="100" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BirthDate" class="form-label"></label>
            <input type="date" id="BirthDate" name="BirthDate" class="form-control" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" />
            <span asp-validation-for="BirthDate" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LoyaltyPoints" class="form-label req"></label>
            <input asp-for="LoyaltyPoints" type="number" min="0" class="form-control" />
            <span asp-validation-for="LoyaltyPoints" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-md-4 pt-md-2">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> @(isNew ? "Save" : "Update")</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
