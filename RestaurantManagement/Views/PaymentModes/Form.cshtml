@model PaymentMode
@{
    var isNew = Model.PaymentModeId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "Payment Mode";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-credit-card"></i> @(isNew ? "Add" : "Edit") Payment Mode</h1>
        <p class="page-sub">Cash, UPI, cards and other ways a customer can pay.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.PaymentModeId.ToString())" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="PaymentModeId" />
            <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ModeName" class="form-label req"></label>
            <input asp-for="ModeName" type="text" class="form-control" maxlength="50" />
            <span asp-validation-for="ModeName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ModeType" class="form-label req"></label>
            <select asp-for="ModeType" class="form-select"><option>Cash</option><option>Card</option><option>UPI</option><option>Online</option><option>Wallet</option><option>Other</option></select>
            <span asp-validation-for="ModeType" class="text-danger small"></span>
        </div>
        <div class="col-md-6"><div class="form-check form-switch mt-md-4 pt-md-2"><input asp-for="RequiresReference" class="form-check-input" role="switch" /><label asp-for="RequiresReference" class="form-check-label"></label></div></div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-md-4 pt-md-2">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> @(isNew ? "Save" : "Update")</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
